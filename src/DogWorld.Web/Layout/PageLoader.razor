<div class="page-loader">
    <div class="loader-caption" role="status" aria-live="polite">
        <span class="loader-paw" aria-hidden="true">🐾</span>
        <div><strong>@Message</strong><span>A little patience. A lot of love.</span></div>
        <span class="loader-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <div class="skeleton-grid @(Details ? "details" : "")" aria-hidden="true">
        @for (var index = 0; index < (Details ? 1 : 3); index++)
        {
            <div class="skeleton-card">
                <div class="skeleton-photo shimmer"><span>♡</span></div>
                <div class="skeleton-copy"><div class="skeleton-line title shimmer"></div><div class="skeleton-line subtitle shimmer"></div><div class="skeleton-rule"></div><div class="skeleton-line short shimmer"></div></div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = "Loading available dogs…";
    [Parameter] public bool Details { get; set; }
}
